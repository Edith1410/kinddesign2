---
const{produkt} = Astro.props;
import Button from "../components/Button.astro";

const endpoint = "https://etyaeqxpnqykzsttqmdi.supabase.co/rest/v1/events?select=*";

const options = {
    headers:{
        apikey:"sb_publishable_xiHoyVhRIwnXiL6L-HwFBA_hUgNxt72"
    },
}

const data = await fetch(endpoint, options).then((res)=> res.json())
---
<a href=`../details/${produkt.id}`>
<article>
    <div class="event-image">
    <img src={produkt.image_url} alt={produkt.titel}/>
    </div>
    <div class="event-info">
    <h2>{produkt.titel}</h2>
    <p>📅 {produkt.dato}</p>
    <p>🕣 {produkt.tid}</p>
    <p>💲 {produkt.pris},- kr.</p>
     <Button/>
    </div>
</article>
</a>

<style>

@font-face {
  font-family: "InterBold";
  src: url("../fonts/Inter_18pt-ExtraBold.woff2") format("woff2");
  font-weight: normal;
}
@font-face {
  font-family: "InterMedium";
  src: url("../fonts/Inter_24pt-ExtraLight.woff2") format("woff2");
  font-weight: normal;
}
h2{
    font-family: InterBold;
     color:#2C0B11 ;
}
p{
    font-family: InterMedium;
     color:#2C0B11 ;
}
    article{
        padding: 1rem;
        background-color: #FCF9F0;
        display: grid;
        grid-template-columns: 1fr 1fr;
    }
    img{
        max-width: 80%;
    }
    a{
        text-decoration:none;
        color: inherit
    }
</style>