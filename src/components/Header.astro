---
import Contactbutton from "../components/Contactbutton.astro";
---


<header class="navbar">

			<div class="logo">
			<img src="/src/img/glogo_result.webp" alt="">
			</div>
			<nav class="nav-links">
				<a href="/">HOME</a>
				<a href="/event">EVENTS</a>
				<a href="/about">ABOUT</a>
			</nav>
				
			<div class="contact-btn">
				 <Contactbutton/>
			</div>
		</header>

        <style>
            	/*header*/
	.navbar {
  background-color: #2C0B11;
  display: flex;
  height: 141px;
  align-items: center;
  justify-content: space-between;
  padding: 0 45px;
}
.logo {
  display: flex;
  align-items: center;
}

.logo img {
  width: 160px;
  height: 85px;
  object-fit: contain;
}

	/* Navigation links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 44px;
}

.nav-links a {
  color: #fff9f1;
  font-size: 14px;
  font-weight: 400;
  text-decoration: none;
  text-transform: uppercase;
  transition: opacity 0.2s ease;
}

.nav-links a:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}
        </style>