---
import Contactbutton from "../components/Contactbutton.astro";
---


<header class="navbar">

			<div class="logo">
			<img src="/src/img/glogo_result.webp" alt="">
			</div>

			<button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">
				<span></span>
				<span></span>
				<span></span>
			</button>

			<nav class="nav-links">
				<a href="/">HOME</a>
				<a href="/event">EVENTS</a>
				<a href="/about">ABOUT</a>
			</nav>
				
			<div class="contact-btn">
				 <Contactbutton/>
			</div>
		</header>

        <style>

                    @font-face {
  font-family: "ExtraBig";
  src: url("../fonts/ArchivoBlack-Regular.woff2") format("woff2");
  font-weight: normal;
          }
@font-face {
  font-family: "InterMedium";
  src: url("../fonts/Inter_24pt-ExtraLight.woff2") format("woff2");
  font-weight: normal;
}
a{
  font-family: InterMedium;
}
            	/*header*/
	.navbar {
  background-color: #2C0B11;
  display: flex;
  height: 141px;
  align-items: center;
  justify-content: space-between;
  padding: 0 45px;
  position: relative;
}
.logo {
  display: flex;
  align-items: center;
}

.logo img {
  width: 160px;
  height: 85px;
  object-fit: contain;
}

	/* Navigation links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 44px;
}

.nav-links a {
  color: #fff9f1;
  font-size: 14px;
  font-weight: 400;
  text-decoration: none;
  text-transform: uppercase;
  transition: opacity 0.2s ease;
}

.nav-links a:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

.menu-toggle {
  display: none;
  background: transparent;
  border: none;
  width: 44px;
  height: 44px;
  padding: 0;
  cursor: pointer;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 5px;
}

.menu-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: #fff9f1;
  border-radius: 2px;
}

@media (max-width: 768px) {
  .navbar {
    height: auto;
    padding: 18px 20px;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .logo {
    flex: 1;
    justify-content: flex-start;
  }

  .menu-toggle {
    display: flex;
  }

  .nav-links {
    display: none;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 8px 0 0;
  }

  .navbar.open .nav-links {
    display: flex;
  }

   .contact-btn {
    display: none;
}
        </style>

<script>
  const navbar = document.querySelector('.navbar');
  const menuToggle = document.querySelector('.menu-toggle');

  if (navbar && menuToggle) {
    menuToggle.addEventListener('click', () => {
      const isOpen = navbar.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
    });

    navbar.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navbar.classList.remove('open');
        menuToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>