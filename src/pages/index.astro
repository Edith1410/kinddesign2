---


<Layout>
	<section class="hero">
  <div class="hero-content">
    <h1>CREATIVE<br>COMMUNITY</h1>

    <p>
      For all kinds of designers,<br>
      meetups & events
    </p>

	<Explorebtn />
    
  </div>
</section>
   <!-- <h1>CREATIVE COMMUNITY</h1> -->
    <section class="more-section">
		<div>
		<img src="/src/img/f1_result.webp" alt="">
		<h3>What is Kinddesign?</h3>
		<p>We're a creative community for all kind of designers meeting in inspiring .....</p>
		<Morelink />
		</div>
		<div>
		<img src="/src/img/f2_result.webp" alt="">
		<h3>How to join us?</h3>
		<p>It's simpler then you think - Follow us on social media and you won't miss anything.</p>
		<Morelink />
		</div>
		<div>
		<img src="/src/img/f3_result.webp" alt="">
		<h3>Do you want to collab?</h3>
		<p>Feel free to contact us if you want to collab.</p>
		<Morelink />
		</div>
    </section>

	<h1>UPCOMING EVENT</h1>
	<Fcard />
</Layout>

<style>
	.hero{
		height: 100%;
		width: 100%;
	}


	.more-section{
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		padding: 2rem;
		margin: 2rem;
		img{
			max-width: 400px;
		}
		
	}
	  h1{
        text-align: center;
    }

	/* hero section */
	.hero {
  height: 600px;
  width: 100%;
  background-image: url("/src/img/hero_result.webp");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  align-items: center;
  padding-left: 45px;

  box-sizing: border-box;
}

.hero-content {
  color: #fffdf0;
  max-width: 350px;
}

.hero-content h1 {
  font-size: 46px;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 18px;
}

.hero-content p {
  font-size: 18px;
  line-height: 1.2;
  margin-bottom: 35px;
}
</style>