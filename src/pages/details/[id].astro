---
import Layout from "../../layouts/Layout.astro";
import Buybtn from "../../components/Buybtn.astro"

export async function getStaticPaths() {


const endpoint = "https://etyaeqxpnqykzsttqmdi.supabase.co/rest/v1/events?select=*";

const options = {
    headers:{
        apikey:"sb_publishable_xiHoyVhRIwnXiL6L-HwFBA_hUgNxt72"
    },
}
  const response = await fetch(endpoint, options);
  const data: any[] = await response.json();

  return data.map((event) => {
    return {
      params: { id: event.id.toString() },
      props: { event },
    };
  });
}

const { id } = Astro.params;
const { event } = Astro.props;
---
<Layout>
<article>
    <div class="event-image">
    <img src={event.image_url} alt={event.titel}/>
    </div>
    <div class="event-info">
    <h2>{event.titel}</h2>
    <p><img src="/src/img/calender_result.webp" alt="calender">{event.dato}</p>
    <p><img src="/src/img/time.webp" alt="location"> {event.tid}</p>
    <p><img src="/src/img/money_result.webp" alt="price"> {event.pris},- kr.</p>
    <p>{event.beskrivelse}</p>
    <Buybtn />
    </div>
</article>
</Layout>

<style>

    @font-face {
  font-family: "InterBold";
  src: url("../../fonts/Inter_18pt-ExtraBold.woff2") format("woff2");
  font-weight: normal;
}
@font-face {
  font-family: "InterMedium";
  src: url("../../fonts/Inter_24pt-ExtraLight.woff2") format("woff2");
  font-weight: normal;
}
h2{
    font-family: InterBold;
     color:#2C0B11 ;
}
p{
    font-family: InterMedium;
     color:#2C0B11 ;
}
p img{
    max-width: 50px;
    justify-self: center;
}
.event-info p {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 10px 0;
  color: #2C0B11;
}
    article{
        padding: 1rem;
        background-color: #FCF9F0;
        display: grid;
        grid-template-columns: 1fr 1fr;
    }
    img{
        max-width: 80%;
    }
    a{
        text-decoration:none;
        color: inherit
    }
</style>