---
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<Header />
		<slot />
		<footer>


    <div class="footer-contact">
      <h2>CONTACT</h2>
      <a href="mailto:kinddesign.cph@gmail.com">
        Email: kinddesign.cph@gmail.com
      </a>
    </div>

 <div class="footer-newsletter">
    <h2>NEWSLETTER</h2>

    <form>
      <input
        type="email"
        placeholder="E-mail"
        required
      >
    </form>
  </div>
<div class="logo">
			<img src="/src/img/blogo_result.webp" alt="">
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #FCF9F0;
	}
	/*header*/
	.navbar {
  background-color: #2C0B11;
  display: flex;
  height: 141px;
  align-items: center;
  justify-content: space-between;
  padding: 0 45px;
}
.logo {
  display: flex;
  align-items: center;
}

.logo img {
  width: 160px;
  height: 85px;
  object-fit: contain;
}

	/* Navigation links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 44px;
}

.nav-links a {
  color: #fff9f1;
  font-size: 14px;
  font-weight: 400;
  text-decoration: none;
  text-transform: uppercase;
  transition: opacity 0.2s ease;
}

.nav-links a:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* footer */
footer{
	background-color: #DEEFF5;
	display: flex;
	height: 141px;
	align-items: center;
	justify-content: space-between;
	padding: 0 45px;
}

.footer-info {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.footer h2 {
  font-size: 23px;
  font-weight: 800;
  margin-bottom: 5px;
}

.footer a {
  display: block;
  color: #350e14;
  text-decoration: none;
  font-size: 14px;
  font-weight: 300;
  transition: opacity 0.25s ease;
}


/* newsletter */
.footer-newsletter {
  justify-self: center;
}

.footer-newsletter form {
  margin-top: 12px;
}

.footer-newsletter input {
  width: 210px;
  height: 48px;

  border: 3px solid #350e14;
  border-radius: 50px;

  background: #fffdf5;
  padding: 0 20px;

  color: #350e14;

  outline: none;
  transition: box-shadow 0.25s ease;
}

.footer-newsletter input:focus {
  box-shadow: 0 0 0 4px rgba(53, 14, 20, 0.12);
}

.footer-newsletter input::placeholder {
  color: #350e14;
}

</style>
